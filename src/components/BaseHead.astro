---
// Every <head> tag for the site: meta, canonical, social, favicons, JSON-LD,
// and the synchronous no-flash theme script (must be the first child of <head>).
interface Props {
  title: string;
  description: string;
  canonicalPath?: string;
}

const { title, description, canonicalPath = '/' } = Astro.props;

const canonical = new URL(canonicalPath, Astro.site).href;
const ogImage = new URL('/og.png', Astro.site).href;

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Guillermo Barazzutti',
  jobTitle: 'Desarrollador web WordPress',
  url: 'https://gbarazzutti.github.io/',
  image: ogImage,
  email: 'mailto:gbarazzutti2@gmail.com',
  telephone: '+5493813667657',
  address: {
    '@type': 'PostalAddress',
    addressCountry: 'AR',
  },
  knowsLanguage: ['es', 'en'],
  knowsAbout: ['WordPress', 'Desarrollo web', 'Tiendas online', 'SEO', 'Mantenimiento web'],
};
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<script is:inline>
  (function () {
    var d = document.documentElement;
    try {
      // Dark is the default: only an explicit stored 'light' opts out.
      // OS preference is intentionally NOT consulted.
      var stored = localStorage.getItem('theme');
      var dark = stored !== 'light';
      d.classList.toggle('dark', dark);
      d.style.colorScheme = dark ? 'dark' : 'light';
    } catch (e) {
      /* private mode / storage disabled: fall back to the dark default */
      d.classList.add('dark');
      d.style.colorScheme = 'dark';
    }
    d.classList.add('js');
  })();
</script>
<title>{title}</title>
<meta name="description" content={description} />
<meta name="author" content="Guillermo Barazzutti" />
<link rel="canonical" href={canonical} />
<meta name="robots" content="index, follow" />
<meta name="theme-color" content="#0B1120" />
<link rel="icon" href="/favicon.ico" sizes="32x32" />
<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<link rel="sitemap" href="/sitemap-index.xml" />
<meta property="og:type" content="website" />
<meta property="og:site_name" content="Guillermo Barazzutti" />
<meta property="og:locale" content="es_AR" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content="Guillermo Barazzutti — Desarrollo web para tu negocio" />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />
<script type="application/ld+json" is:inline set:html={JSON.stringify(personSchema)} />
