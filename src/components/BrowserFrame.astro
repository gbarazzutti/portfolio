---
import { Image } from 'astro:assets';

interface Props {
  src: ImageMetadata;
  alt: string;
  domain: string;
}

const { src, alt, domain } = Astro.props;
---

<div class="overflow-hidden rounded-xl border border-[var(--border)] bg-[var(--surface-2)]">
  <div class="flex items-center gap-3 border-b border-[var(--border)] px-3 py-2">
    <span class="flex shrink-0 gap-1.5" aria-hidden="true">
      <span class="size-2.5 rounded-full bg-[var(--text-muted)]/40"></span>
      <span class="size-2.5 rounded-full bg-[var(--text-muted)]/40"></span>
      <span class="size-2.5 rounded-full bg-[var(--text-muted)]/40"></span>
    </span>
    <span
      class="mx-auto max-w-[70%] truncate rounded-full bg-[var(--bg)]/60 px-3 py-0.5 text-xs text-[var(--text-muted)]"
    >
      {domain}
    </span>
  </div>
  <Image
    src={src}
    alt={alt}
    widths={[480, 768, 1024, 1568]}
    sizes="(min-width: 640px) 45vw, 100vw"
    class="aspect-[1568/714] w-full object-cover object-top transition-transform duration-300 group-hover:scale-[1.02]"
  />
</div>
