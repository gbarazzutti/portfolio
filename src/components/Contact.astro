---
// Contact panel, two columns on desktop: the pitch + quick links on the
// left, the Netlify form on the right. The form is picked up by Netlify's
// build-time parser via `data-netlify`; `public/__forms.html` mirrors the
// fields as a detection fallback.
const inputClass =
  'w-full rounded-md border border-[var(--border)] bg-[var(--surface-2)] px-3 py-2 text-[var(--text)] placeholder:text-[var(--text-muted)] focus-visible:outline-3 focus-visible:outline-offset-2 focus-visible:outline-[var(--accent)]';
const btn =
  'inline-flex items-center justify-center gap-2 rounded-md px-5 py-3 font-semibold transition duration-200 hover:-translate-y-0.5 focus-visible:outline-3 focus-visible:outline-offset-2 focus-visible:outline-[var(--accent)]';
---
<div
  class="relative isolate overflow-hidden rounded-2xl border border-[var(--border)] bg-[var(--surface)] p-8 sm:p-10"
>
  <div
    class="pointer-events-none absolute inset-0 -z-10 bg-gradient-to-br from-[var(--accent)]/10 to-transparent"
  >
  </div>

  <div class="grid gap-10 lg:grid-cols-[minmax(0,2fr)_minmax(0,3fr)] lg:gap-14">
    <div>
      <p class="text-[var(--text-muted)]">
        ¿Tenés un proyecto en mente o un sitio que necesita mejoras? Escribime y lo conversamos sin
        compromiso.
      </p>

      <div class="mt-6 flex flex-col gap-3">
        <a
          href="mailto:gbarazzutti2@gmail.com"
          class={`${btn} w-full bg-[var(--accent)] text-[var(--on-accent)] hover:bg-[var(--accent-hover)]`}
        >
          <svg
            class="size-5 shrink-0"
            aria-hidden="true"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <rect x="3" y="5" width="18" height="14" rx="2"></rect>
            <path d="m3 7 9 6 9-6"></path>
          </svg>
          gbarazzutti2@gmail.com
        </a>
        <a
          href="https://wa.me/5493813667657"
          target="_blank"
          rel="noopener noreferrer"
          class={`${btn} w-full border border-[var(--accent)]/40 text-[var(--accent)] hover:bg-[var(--accent)]/10`}
        >
          <svg class="size-5 shrink-0" aria-hidden="true" viewBox="0 0 24 24" fill="currentColor">
            <path
              d="M.057 24l1.687-6.163a11.867 11.867 0 01-1.587-5.945C.16 5.335 5.495 0 12.05 0a11.817 11.817 0 018.413 3.488 11.824 11.824 0 013.48 8.414c-.003 6.557-5.338 11.892-11.893 11.892a11.9 11.9 0 01-5.688-1.448L.057 24zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884a9.86 9.86 0 001.51 5.26l-.999 3.648 3.978-1.607zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.767.967-.94 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.29.173-1.414z"
            ></path>
          </svg>
          WhatsApp<span class="sr-only"> (abre en una pestaña nueva)</span>
        </a>
      </div>

      <div class="mt-6 space-y-1 text-sm text-[var(--text-muted)]">
        <p class="inline-flex items-center gap-2">
          <svg
            class="size-4 shrink-0 text-[var(--accent)]"
            aria-hidden="true"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <circle cx="12" cy="12" r="9"></circle>
            <path d="M12 7v5l3 2"></path>
          </svg>
          Respondo en el día.
        </p>
        <p>
          <span class="font-semibold text-[var(--text)]">+5 años</span>
          <span class="mx-1.5">·</span>
          <span class="font-semibold text-[var(--text)]">+20 sitios</span>
        </p>
      </div>
    </div>

    <div
      class="border-t border-[var(--border)] pt-8 lg:border-t-0 lg:border-l lg:pt-0 lg:pl-14"
    >
      <p class="text-sm font-semibold text-[var(--text)]">O escribime desde acá</p>

      <form
        name="contacto"
        method="POST"
        data-netlify="true"
        data-netlify-honeypot="bot-field"
        action="/gracias"
        class="mt-4 grid gap-4"
      >
        <input type="hidden" name="form-name" value="contacto" />
        <p class="hidden">
          <label>No completes esto si sos humano: <input name="bot-field" /></label>
        </p>

        <div class="grid gap-4 sm:grid-cols-2">
          <div class="grid gap-1.5">
            <label for="nombre" class="text-sm font-medium text-[var(--text)]">Nombre</label>
            <input
              id="nombre"
              name="nombre"
              type="text"
              required
              autocomplete="name"
              class={inputClass}
            />
          </div>

          <div class="grid gap-1.5">
            <label for="email" class="text-sm font-medium text-[var(--text)]">Email</label>
            <input
              id="email"
              name="email"
              type="email"
              required
              autocomplete="email"
              class={inputClass}
            />
          </div>
        </div>

        <div class="grid gap-1.5">
          <label for="mensaje" class="text-sm font-medium text-[var(--text)]">Mensaje</label>
          <textarea id="mensaje" name="mensaje" rows="5" required class={inputClass}></textarea>
        </div>

        <button
          type="submit"
          class={`${btn} w-full bg-[var(--accent)] text-[var(--on-accent)] hover:bg-[var(--accent-hover)] sm:w-fit`}
        >
          Enviar mensaje
        </button>
      </form>
    </div>
  </div>
</div>
