  <div class="mx-auto flex max-w-5xl flex-col gap-2 px-4 py-10 text-sm text-[var(--text-muted)] sm:flex-row sm:items-center sm:justify-between">
    <p>© {year} Guillermo Barazzutti · Argentina</p>
    <p class="flex flex-wrap gap-x-4 gap-y-1">
      <a
        href="mailto:gbarazzutti2@gmail.com"
        class="text-[var(--accent)] underline underline-offset-2 hover:text-[var(--accent-hover)] focus-visible:outline-3 focus-visible:outline-offset-2 focus-visible:outline-[var(--accent)]"
      >
        gbarazzutti2@gmail.com
      </a>
      <a
        href="https://wa.me/5493813667657"
        target="_blank"
        rel="noopener noreferrer"
        class="text-[var(--accent)] underline underline-offset-2 hover:text-[var(--accent-hover)] focus-visible:outline-3 focus-visible:outline-offset-2 focus-visible:outline-[var(--accent)]"
