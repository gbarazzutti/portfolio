---
// The single <h1> on the site.
---
<section
  class="hero-glow relative isolate mx-auto w-full max-w-5xl px-4 pt-20 pb-16 sm:pt-28 sm:pb-24"
>
  <div class="reveal">
    <p class="mb-3 text-sm font-semibold tracking-[0.2em] text-[var(--accent)] uppercase">
      Desarrollo WordPress · Córdoba, Argentina
    </p>
    <h1
      class="max-w-3xl text-4xl leading-[1.05] font-extrabold tracking-tight text-[var(--text)] sm:text-6xl"
    >
      Desarrollo sitios web profesionales que trabajan para tu negocio.
    </h1>
    <p class="mt-6 max-w-2xl text-lg text-[var(--text-muted)]">
      Soy Guillermo Barazzutti, desarrollador WordPress con más de 5 años de experiencia. Construyo y
      mantengo sitios rápidos, claros y fáciles de administrar para empresas, emprendedores y
      comunidades.
    </p>
    <p class="mt-8">
      <a
        href="#proyectos"
        class="inline-block rounded-md bg-[var(--accent)] px-5 py-3 font-semibold text-[var(--on-accent)] shadow-lg shadow-[var(--accent)]/20 transition duration-200 hover:-translate-y-0.5 hover:bg-[var(--accent-hover)] hover:shadow-xl hover:shadow-[var(--accent)]/30 focus-visible:outline-3 focus-visible:outline-offset-2 focus-visible:outline-[var(--accent)]"
      >
        Ver mis proyectos
      </a>
    </p>
  </div>
</section>
