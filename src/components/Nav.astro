---
import ThemeToggle from './ThemeToggle.astro';

// Absolute (`/#…`) so they also work from secondary pages like /gracias.
const links = [
  { href: '/#servicios', label: 'Servicios' },
  { href: '/#proyectos', label: 'Proyectos' },
  { href: '/#sobre-mi', label: 'Sobre mí' },
  { href: '/#contacto', label: 'Contacto' },
];
---

<nav
  id="site-nav"
  aria-label="Principal"
  class="sticky top-0 z-40 h-[var(--header-h)] bg-[var(--bg)]/60 backdrop-blur transition-[background-color,box-shadow] duration-200"
>
  <div class="mx-auto flex h-full max-w-5xl items-center justify-between gap-2 px-4">
    <a
      href="/"
      class="inline-flex items-center gap-2 font-bold text-[var(--text)] focus-visible:outline-3 focus-visible:outline-offset-2 focus-visible:outline-[var(--accent)]"
    >
      <svg class="size-7 shrink-0" viewBox="0 0 64 64" aria-hidden="true">
        <rect width="64" height="64" rx="14" fill="var(--accent)"></rect>
        <path
          fill="#FFFFFF"
          d="M20.6 14.2c3.2 0 6 1 8.2 2.7l-3 3.9c-1.5-1.1-3.2-1.7-5.1-1.7-4.3 0-7.4 3.3-7.4 7.9s3.1 8 7.5 8c1.6 0 3-.3 4.1-.9v-4.6h-5.1v-4.7h10.3v12.2c-2.4 1.8-5.7 2.9-9.5 2.9-7.6 0-13-5.4-13-13S13.1 14.2 20.6 14.2Z"
        ></path>
        <path
          fill="#FFFFFF"
          d="M35.9 14.7h9.8c5.3 0 8.6 2.5 8.6 6.7 0 2.6-1.4 4.5-3.6 5.4 2.9.8 4.7 2.9 4.7 6 0 4.5-3.5 7.2-9.2 7.2H35.9Zm9.2 9.9c2.2 0 3.5-1 3.5-2.8s-1.3-2.7-3.5-2.7h-3.8v5.5Zm.5 10.5c2.4 0 3.8-1.1 3.8-3s-1.4-3-3.8-3h-4.3v6Z"
        ></path>
      </svg>
      Guillermo Barazzutti
    </a>

    <div class="flex items-center gap-1">
      <!-- Desktop links -->
      <ul class="hidden items-center gap-1 sm:flex">
        {links.map((l) => (
          <li>
            <a
              href={l.href}
              class="rounded-md px-3 py-2 text-sm font-medium text-[var(--text-muted)] hover:bg-[var(--surface)] hover:text-[var(--text)] focus-visible:outline-3 focus-visible:outline-offset-2 focus-visible:outline-[var(--accent)]"
            >
              {l.label}
            </a>
          </li>
        ))}
      </ul>

      <ThemeToggle />

      <!-- Mobile disclosure: native <details>, zero JS -->
      <details class="relative sm:hidden">
        <summary
          class="flex cursor-pointer list-none items-center rounded-md p-2 text-[var(--text)] hover:bg-[var(--surface)] focus-visible:outline-3 focus-visible:outline-offset-2 focus-visible:outline-[var(--accent)]"
          aria-label="Abrir menú"
        >
          <svg class="size-5" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
            <path d="M3 6h18M3 12h18M3 18h18"></path>
          </svg>
        </summary>
        <ul
          class="absolute right-0 mt-2 w-48 rounded-md border border-[var(--border)] bg-[var(--bg)] p-2 shadow-lg"
        >
          {links.map((l) => (
            <li>
              <a
                href={l.href}
                class="block rounded-md px-3 py-2 text-sm font-medium text-[var(--text)] hover:bg-[var(--surface)] focus-visible:outline-3 focus-visible:outline-offset-2 focus-visible:outline-[var(--accent)]"
              >
                {l.label}
              </a>
            </li>
          ))}
        </ul>
      </details>
    </div>
  </div>
</nav>
