---
import type { CollectionEntry } from 'astro:content';
import { render } from 'astro:content';
import BrowserFrame from './BrowserFrame.astro';

interface Props {
  entry: CollectionEntry<'projects'>;
}

const { entry } = Astro.props;
const { title, stack, url, displayUrl, image } = entry.data;
const { Content } = await render(entry);
---

<article
  class="project-card group rounded-xl border border-[var(--border)] bg-[var(--surface)] p-5 transition duration-200 hover:-translate-y-0.5 hover:border-[var(--accent)] hover:shadow-lg"
>
  <BrowserFrame src={image} alt={`Captura del sitio ${title}`} domain={displayUrl} />

  <h3 class="text-xl font-semibold text-[var(--text)]">{title}</h3>

  <div class="text-[var(--text-muted)] [&>p]:mt-2 [&>p:first-child]:mt-0">
    <Content />
  </div>

  <div>
    <p class="text-sm font-semibold text-[var(--text)]">Stack</p>
    <ul class="mt-2 flex flex-wrap gap-2">
      {
        stack.map((tech) => (
          <li class="rounded-full border border-[var(--border)] px-2.5 py-0.5 text-xs text-[var(--text-muted)]">
            {tech}
          </li>
        ))
      }
    </ul>
  </div>

  <p class="self-start">
    <a
      href={url}
      target="_blank"
      rel="noopener noreferrer"
      class="inline-flex items-center gap-1 rounded-md border border-[var(--accent)]/40 px-3 py-1.5 text-sm font-medium text-[var(--accent)] transition duration-200 hover:bg-[var(--accent)]/10 focus-visible:outline-3 focus-visible:outline-offset-2 focus-visible:outline-[var(--accent)]"
    >
      Ver sitio: {displayUrl}<span class="sr-only"> (abre en una pestaña nueva)</span>
    </a>
  </p>
</article>
