---
interface Props {
  id: string;
  title: string;
  kicker?: string;
  /** Small decorative accent prefix before the <h2>, e.g. "01". aria-hidden. */
  num?: string;
  /** Full-bleed surface band behind the section; inner content stays centred. */
  band?: boolean;
}

const { id, title, kicker, num, band = false } = Astro.props;
const headingId = `${id}-titulo`;
---

<section
  id={id}
  aria-labelledby={headingId}
  class:list={['w-full', band && 'bg-[var(--surface)]']}
>
  <div class="reveal mx-auto w-full max-w-5xl px-4 py-16 sm:py-20">
    {kicker && (
      <p class="mb-2 text-sm font-semibold tracking-wide text-[var(--accent)] uppercase">{kicker}</p>
    )}
    <h2 id={headingId} class="text-2xl font-bold text-[var(--text)] sm:text-3xl">
      {num && (
        <span aria-hidden="true" class="mr-2 font-semibold text-[var(--accent)] tabular-nums">{num}</span>
      )}{title}
    </h2>
    <div class="mt-6">
      <slot />
    </div>
  </div>
</section>
