---
interface Props {
  id: string;
  title: string;
  kicker?: string;
}

const { id, title, kicker } = Astro.props;
const headingId = `${id}-titulo`;
---

<section id={id} aria-labelledby={headingId} class="mx-auto w-full max-w-5xl px-4 py-16 sm:py-20">
  {kicker && (
    <p class="mb-2 text-sm font-semibold tracking-wide text-[var(--accent)] uppercase">{kicker}</p>
  )}
  <h2 id={headingId} class="text-2xl font-bold text-[var(--text)] sm:text-3xl">{title}</h2>
  <div class="mt-6">
    <slot />
  </div>
</section>
