---
interface Props {
  title: string;
  summary: string;
  icon?: 'institucional' | 'contenido' | 'optimizacion' | 'autonomia';
}

const { title, summary, icon } = Astro.props;

// Inline line-art SVG paths, one per `icon` enum value. Stroke style matches the
// theme-toggle icons (fill:none, currentColor, width 2, round caps/joins).
const ICONS: Record<NonNullable<Props['icon']>, string> = {
  institucional:
    '<path d="M3 21h18"/><path d="M5 21V8l7-4 7 4v13"/><path d="M9 21v-5h6v5"/><path d="M9 10h.01"/><path d="M15 10h.01"/>',
  contenido:
    '<path d="M4 5h16"/><path d="M4 12h16"/><path d="M4 19h10"/><path d="M18 17l3 2-3 2"/>',
  optimizacion:
    '<path d="M4 20a8 8 0 1 1 16 0"/><path d="M12 12l5-5"/><path d="M12 20v.01"/>',
  autonomia:
    '<path d="M12 3a4 4 0 0 1 4 4c0 1.7-.8 2.8-1.5 3.8-.5.7-.8 1.4-.9 2.2H10.4c-.1-.8-.4-1.5-.9-2.2C8.8 9.8 8 8.7 8 7a4 4 0 0 1 4-4z"/><path d="M10 17h4"/><path d="M10.5 20h3"/>',
};

const iconMarkup = icon ? ICONS[icon] : null;
---

<article
  class="service-card group relative flex flex-col overflow-hidden rounded-lg border border-[var(--border)] bg-[var(--surface)] p-6 transition duration-200 hover:-translate-y-0.5 hover:border-[var(--accent)] hover:shadow-lg"
>
  {iconMarkup && (
    <span
      class="mb-4 inline-flex size-11 items-center justify-center rounded-lg bg-[var(--accent)]/10 text-[var(--accent)]"
    >
      <svg
        class="size-6"
        aria-hidden="true"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        set:html={iconMarkup}
      />
    </span>
  )}
  <h3 class="text-lg font-semibold text-[var(--text)]">{title}</h3>
  <p class="mt-2 text-[var(--text-muted)]">{summary}</p>
</article>
