---
interface Props {
  title: string;
  summary: string;
  icon?: 'institucional' | 'contenido' | 'optimizacion' | 'autonomia';
}

const { title, summary } = Astro.props;
---

<article class="rounded-lg border border-[var(--border)] bg-[var(--surface)] p-6">
  <h3 class="text-lg font-semibold text-[var(--text)]">{title}</h3>
  <p class="mt-2 text-[var(--text-muted)]">{summary}</p>
</article>
