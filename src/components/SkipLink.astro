---
// First focusable element in <body>. Hidden until focused, then visible.
// Target is <main id="contenido" tabindex="-1"> so focus actually lands there.
---
<a
  href="#contenido"
  class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:z-50 focus:rounded focus:bg-[var(--accent)] focus:px-4 focus:py-2 focus:text-[var(--on-accent)]"
>
  Saltar al contenido
</a>
