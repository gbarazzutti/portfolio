---
// Dark-mode toggle. The only bundled <script> on the site (~0.6 KB).
// Icon swap is pure CSS (dark:hidden / hidden dark:block) — no JS DOM work
// beyond flipping the `.dark` class on <html>.
---

<button
  id="theme-toggle"
  type="button"
  aria-pressed="false"
  aria-label="Modo oscuro"
  class="rounded-md p-2 text-[var(--text)] hover:bg-[var(--surface)] focus-visible:outline-3 focus-visible:outline-offset-2 focus-visible:outline-[var(--accent)]"
>
  <svg class="icon-sun size-5 dark:hidden" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
    <circle cx="12" cy="12" r="4"></circle>
    <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"></path>
  </svg>
  <svg class="icon-moon size-5 hidden dark:block" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
    <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
  </svg>
</button>

<script>
  const btn = document.getElementById('theme-toggle');
  const root = document.documentElement;
  const sync = () => btn?.setAttribute('aria-pressed', String(root.classList.contains('dark')));
  sync();
  btn?.addEventListener('click', () => {
    const isDark = root.classList.toggle('dark');
    root.style.colorScheme = isDark ? 'dark' : 'light';
    try { localStorage.setItem('theme', isDark ? 'dark' : 'light'); } catch {}
    sync();
  });
</script>
