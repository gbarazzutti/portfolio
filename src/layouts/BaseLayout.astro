---
import '@fontsource-variable/source-sans-3';
import '../styles/global.css';
import BaseHead from '../components/BaseHead.astro';
import SkipLink from '../components/SkipLink.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description: string;
  canonicalPath?: string;
}

const { title, description, canonicalPath = '/' } = Astro.props;
---

<!doctype html>
<html lang="es-AR" class="scroll-smooth">
  <head>
    <BaseHead title={title} description={description} canonicalPath={canonicalPath} />
  </head>
  <body class="bg-[var(--bg)] text-[var(--text)] antialiased">
    <SkipLink />
    <header>
      <Nav />
    </header>
    <main id="contenido" tabindex="-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
