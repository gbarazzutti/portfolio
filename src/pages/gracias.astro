---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = 'Gracias — Guillermo Barazzutti';
const description = 'Recibí tu mensaje. Te respondo a la brevedad.';
---

<BaseLayout title={title} description={description} canonicalPath="/gracias" noindex>
  <section class="mx-auto flex min-h-[60vh] w-full max-w-2xl flex-col justify-center px-4 py-24">
    <p class="text-sm font-semibold tracking-[0.2em] text-[var(--accent)] uppercase">Mensaje enviado</p>
    <h1 class="mt-3 text-4xl font-extrabold tracking-tight text-[var(--text)] sm:text-5xl">
      ¡Gracias! Te respondo a la brevedad.
    </h1>
    <p class="mt-6 text-lg text-[var(--text-muted)]">
      Recibí tu mensaje. Si es urgente, escribime directo por
      <a
        href="https://wa.me/5493813667657"
        target="_blank"
        rel="noopener noreferrer"
        class="font-medium text-[var(--accent)] underline underline-offset-2 hover:text-[var(--accent-hover)]"
        >WhatsApp<span class="sr-only"> (abre en una pestaña nueva)</span></a
      >.
    </p>
    <p class="mt-8">
      <a
        href="/"
        class="inline-block rounded-md border border-[var(--accent)]/40 px-5 py-3 font-semibold text-[var(--accent)] transition duration-200 hover:-translate-y-0.5 hover:bg-[var(--accent)]/10 focus-visible:outline-3 focus-visible:outline-offset-2 focus-visible:outline-[var(--accent)]"
      >
        Volver al inicio
      </a>
    </p>
  </section>
</BaseLayout>
