---
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/Section.astro';
import { experiencia, stack } from '../data/trayectoria';

const title = 'Trayectoria — Guillermo Barazzutti';
const description =
  'Experiencia y stack técnico de un desarrollador WordPress con más de 5 años en producción: recorrido profesional, capacidades técnicas y formación en curso.';

// Inline accent link — matches the underline-offset style used across the site.
const inlineLink =
  'font-medium text-[var(--accent)] underline underline-offset-2 hover:text-[var(--accent-hover)] focus-visible:outline-3 focus-visible:outline-offset-2 focus-visible:outline-[var(--accent)]';
// Button-style link — mirrors the outlined project links.
const btnLink =
  'inline-flex items-center gap-1 rounded-md border border-[var(--accent)]/40 px-3 py-1.5 text-sm font-medium text-[var(--accent)] transition duration-200 hover:bg-[var(--accent)]/10 focus-visible:outline-3 focus-visible:outline-offset-2 focus-visible:outline-[var(--accent)]';
// Primary button — mirrors the hero CTA.
const btnPrimary =
  'inline-block rounded-md bg-[var(--accent)] px-5 py-3 font-semibold text-[var(--on-accent)] shadow-lg shadow-[var(--accent)]/20 transition duration-200 hover:-translate-y-0.5 hover:bg-[var(--accent-hover)] hover:shadow-xl hover:shadow-[var(--accent)]/30 focus-visible:outline-3 focus-visible:outline-offset-2 focus-visible:outline-[var(--accent)]';
---

<BaseLayout title={title} description={description} canonicalPath="/trayectoria">
  <!-- Intro -->
  <section class="mx-auto w-full max-w-5xl px-4 pt-20 pb-10 sm:pt-28 sm:pb-14">
    <div class="reveal max-w-3xl">
      <p class="mb-3 text-sm font-semibold tracking-[0.2em] text-[var(--accent)] uppercase">
        Trayectoria
      </p>
      <h1
        class="text-4xl leading-[1.05] font-extrabold tracking-tight text-[var(--text)] sm:text-5xl"
      >
        Experiencia y stack técnico
      </h1>
      <div class="mt-6 space-y-4 text-lg text-[var(--text-muted)]">
        <p>
          Desarrollador WordPress con más de 5 años construyendo, manteniendo y optimizando sitios
          en producción. Hoy administro más de 20 sitios en vivo, muchos multilingües y con gran
          volumen de contenido.
        </p>
        <p>
          Vengo del desarrollo backend en Ruby on Rails y sigo formándome en PHP avanzado,
          arquitecturas modernas y QA. Antes pasé varios años en atención al cliente y ventas.
        </p>
      </div>

      <p class="mt-8 flex flex-wrap gap-3">
        <a
          href="https://linkedin.com/in/gbarazzutti"
          target="_blank"
          rel="noopener noreferrer"
          class={btnLink}
        >
          <svg class="size-4 shrink-0" aria-hidden="true" viewBox="0 0 24 24" fill="currentColor">
            <path
              d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14zM8.34 18.34V9.66H5.67v8.68h2.67zM7 8.53a1.55 1.55 0 1 0 0-3.1 1.55 1.55 0 0 0 0 3.1zm11.34 9.81v-4.76c0-2.55-1.36-3.74-3.18-3.74-1.47 0-2.12.81-2.49 1.38v-1.18h-2.66c.04.75 0 8.68 0 8.68h2.66v-4.85c0-.24.02-.48.09-.65.19-.48.63-.97 1.36-.97.96 0 1.35.73 1.35 1.8v4.67h2.6z"
            ></path>
          </svg>
          LinkedIn<span class="sr-only"> (abre en una pestaña nueva)</span>
        </a>
        <a
          href="https://github.com/gbarazzutti"
          target="_blank"
          rel="noopener noreferrer"
          class={btnLink}
        >
          <svg class="size-4 shrink-0" aria-hidden="true" viewBox="0 0 24 24" fill="currentColor">
            <path
              d="M12 2a10 10 0 0 0-3.16 19.49c.5.09.68-.22.68-.48l-.01-1.7c-2.78.6-3.37-1.34-3.37-1.34-.45-1.16-1.11-1.47-1.11-1.47-.91-.62.07-.6.07-.6 1 .07 1.53 1.03 1.53 1.03.89 1.53 2.34 1.09 2.91.83.09-.65.35-1.09.63-1.34-2.22-.25-4.55-1.11-4.55-4.94 0-1.09.39-1.98 1.03-2.68-.1-.25-.45-1.27.1-2.65 0 0 .84-.27 2.75 1.02a9.56 9.56 0 0 1 5 0c1.91-1.29 2.75-1.02 2.75-1.02.55 1.38.2 2.4.1 2.65.64.7 1.03 1.59 1.03 2.68 0 3.84-2.34 4.69-4.57 4.94.36.31.68.92.68 1.85l-.01 2.75c0 .27.18.58.69.48A10 10 0 0 0 12 2z"
            ></path>
          </svg>
          GitHub<span class="sr-only"> (abre en una pestaña nueva)</span>
        </a>
      </p>
    </div>
  </section>

  <!-- Experiencia -->
  <Section id="experiencia" title="Experiencia" num="01">
    <ol class="relative space-y-10 border-l border-[var(--border)] pl-6 sm:pl-8">
      {
        experiencia.map((job) => (
          <li class="relative">
            <span
              class="absolute top-2 -left-6 size-3 -translate-x-1/2 rounded-full border-2 border-[var(--accent)] bg-[var(--bg)] sm:-left-8"
              aria-hidden="true"
            />
            <h3 class="text-lg font-semibold text-[var(--text)]">
              {job.role} — {job.org}
            </h3>
            <p class="mt-0.5 text-sm font-semibold text-[var(--accent)]">{job.period}</p>
            <ul class="mt-3 list-disc space-y-2 pl-5 text-[var(--text-muted)] marker:text-[var(--text-muted)]">
              {job.bullets.map((b) => (
                <li>{b}</li>
              ))}
            </ul>
          </li>
        ))
      }
    </ol>
  </Section>

  <!-- Más allá de WordPress -->
  <Section id="mas-alla-de-wordpress" title="Más allá de WordPress" num="02" band>
    <p class="max-w-2xl text-[var(--text-muted)]">
      WordPress es mi base, no mi techo. Varios de mis proyectos y mi formación van más allá del CMS.
    </p>
    <ul class="mt-6 space-y-4 text-[var(--text-muted)]">
      <li>
        <strong class="font-semibold text-[var(--text)]"
          >Desarrollo backend en Ruby on Rails (Dispack / SoffySoft)</strong
        > — rol pago de backend en una app de logística: modelos relacionales en PostgreSQL con
        ActiveRecord, integración de la API de Google Maps para ubicación y precios de envíos, y
        testing con RSpec sobre arquitectura MVC.
      </li>
      <li>
        <strong class="font-semibold text-[var(--text)]"
          >Tema WordPress a medida, desde cero — GymFitness</strong
        > — un tema propio en PHP, HTML, CSS y JavaScript, sin page builders: jerarquía de plantillas,
        templates single y archive, custom post types, secciones dinámicas y componentes
        reutilizables.
      </li>
      <li>
        <strong class="font-semibold text-[var(--text)]">Este sitio</strong> — el portfolio está
        hecho en Astro 5 con TypeScript y Tailwind, contenido tipado con content collections, layout
        con CSS subgrid, tests automatizados (Vitest y Playwright) e integración continua. El código
        es público en
        <a
          href="https://github.com/gbarazzutti"
          target="_blank"
          rel="noopener noreferrer"
          class={inlineLink}
          >GitHub<span class="sr-only"> (abre en una pestaña nueva)</span></a
        >.
      </li>
      <li>
        <strong class="font-semibold text-[var(--text)]">En formación</strong> — PHP avanzado fuera de
        WordPress, conceptos de headless CMS y arquitecturas web modernas, fundamentos de QA, y flujos
        de desarrollo asistidos por IA.
      </li>
    </ul>
  </Section>

  <!-- Stack técnico -->
  <Section id="stack-tecnico" title="Stack técnico" num="03">
    <div class="space-y-8">
      {
        stack.map((group) => (
          <div>
            <h3 class="text-base font-semibold text-[var(--text)]">{group.name}</h3>
            <ul class="mt-3 flex flex-wrap gap-2">
              {group.items.map((item) => (
                <li class="rounded-full border border-[var(--border)] px-2.5 py-0.5 text-xs text-[var(--text-muted)] first-letter:uppercase">
                  {item}
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </Section>

  <!-- Otros trabajos -->
  <Section id="otros-trabajos" title="Otros trabajos" num="04" band>
    <ul class="space-y-4 text-[var(--text-muted)]">
      <li>
        <strong class="font-semibold text-[var(--text)]"
          >Red de sitios del Instituto del Verbo Encarnado</strong
        > — desarrollo, mantenimiento, gestión de contenido y optimización de ejerciciosespirituales.org,
        vozcatolica.com, maradentro.ive.org, iveamerica.org y spiritualexercises.online.
      </li>
      <li>
        <strong class="font-semibold text-[var(--text)]">SIMA Housing (simahousing.com)</strong> —
        sitio corporativo en WordPress para una constructora: maquetación, ajustes responsive,
        estructura de contenido y configuración de WordPress.
      </li>
    </ul>
    <p class="mt-6">
      <a href="/#proyectos" class={btnLink}>Ver los proyectos en detalle</a>
    </p>
  </Section>

  <!-- Formación -->
  <Section id="formacion" title="Formación" num="05">
    <ul class="list-disc space-y-2 pl-5 text-[var(--text-muted)] marker:text-[var(--text-muted)]">
      <li>Bootcamp de desarrollo web full stack, 2021.</li>
      <li>
        Cursos: "Código con Juan" — Desarrollo Web Completo, Desarrollo de Temas WordPress,
        JavaScript Moderno.
      </li>
      <li>
        Actualmente profundizando en PHP avanzado fuera de WordPress, conceptos de headless CMS,
        arquitecturas web modernas, fundamentos de QA y flujos de desarrollo asistidos por IA.
      </li>
    </ul>
  </Section>

  <!-- Idiomas -->
  <Section id="idiomas" title="Idiomas" num="06" band>
    <p class="text-[var(--text-muted)]">
      <span class="font-semibold text-[var(--text)]">Español</span> — nativo
      <span class="mx-2" aria-hidden="true">·</span>
      <span class="font-semibold text-[var(--text)]">Inglés</span> — C1, competencia profesional
    </p>
  </Section>

  <!-- Closing CTA -->
  <section class="mx-auto w-full max-w-5xl px-4 py-16 sm:py-20">
    <div class="reveal">
      <p class="text-lg text-[var(--text-muted)]">¿Te interesa trabajar juntos? Hablemos.</p>
      <p class="mt-6">
        <a href="/#contacto" class={btnPrimary}>Contacto</a>
      </p>
    </div>
  </section>
</BaseLayout>
